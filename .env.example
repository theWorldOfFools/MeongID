# Salin file ini menjadi .env bila ingin mengubah nilai default.
# Semua variabel sudah punya default untuk pemakaian lokal.

# --- Database (container postgres) ---
DB_USER=meong
DB_PASSWORD=meong123
DB_NAME=meongid

# --- Backend ---
JWT_SECRET=ganti-rahasia-ini-di-production
JWT_EXPIRES_IN=30d

# --- Akun demo hasil seed ---
SEED_DEMO_EMAIL=demo@meong.test
SEED_DEMO_PASSWORD=meong123

# --- Frontend ---
# Kosongkan (default) agar API memakai origin yang sama lewat proxy nginx/vite.
# Isi dengan URL absolut hanya bila frontend & backend dipisah host, mis.
# VITE_API_URL=https://xxxx.ngrok-free.app
VITE_API_URL=
